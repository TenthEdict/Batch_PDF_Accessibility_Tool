FROM ubuntu:22.04 as base

# Set up environment
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3-pip \
    python3.11-venv \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-osd \
    poppler-utils \
    libpoppler-dev \
    ghostscript \
    libgl1-mesa-glx \
    file \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create smaller final image
FROM base as app

# Create app directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Install academic term dictionaries
COPY resources/academic_terms.txt /usr/share/tesseract-ocr/5/tessdata/academic_terms.txt

# Copy configuration
COPY config/academic.yaml /app/config/academic.yaml

# Copy application code
COPY src/ /app/src/
COPY scripts/ /app/scripts/

# Create volume mount points with appropriate permissions
RUN mkdir -p /data/input /data/output /data/logs \
    && chmod 777 /data/input /data/output /data/logs

# Set entrypoint
COPY scripts/docker-entrypoint.sh /
RUN chmod +x /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]

# Default command
CMD ["academic"]