# ===================================================================
# Archived and legacy content
# ===================================================================
# Exclude entire archived directory from version control
# This contains deprecated code, old documentation, and test outputs
archived/
archived/**/*

# Legacy files that should be removed
legacy_*.py
old_*.py
deprecated_*.py
*_old.py
*_backup.py
*_BACKUP.*
*_OLD.*
*_DEPRECATED.*

# ===================================================================
# Documentation (local only - not for remote repository)
# ===================================================================
# Exclude ALL markdown files except root README.md
*.md
!README.md

# Specifically exclude docs directory
docs/
docs/**/*
docs/**/*.md

# Exclude any markdown files in subdirectories
**/*.md
!README.md

# ===================================================================
# Security and compliance
# ===================================================================
# Security scan results
bandit-report.json
safety-report.json
vulnerability-report.json
*.sarif
security-report*.json
vulnerability-report*.json

# Compliance and audit files
audit_*.log
compliance_*.json
security_*.txt

# ===================================================================
# Implementation and Development Documentation
# ===================================================================
# Keep final implementation reports but ignore work-in-progress
*_WIP.md
*_DRAFT.md
*_TEMP.md

# ===================================================================
# Performance and profiling
# ===================================================================
performance-profile*.json
*.prof
profile_*.log

# Temporary processing artifacts from new features
epubs_*.tmp
.epubs_temp/

