experiments/
notebooks/
*.ipynb_checkpoints/

# Generated documentation (keep source, ignore generated)
docs/_build/
docs/.doctrees/
site/

# Lock files from dependency managers (keep requirements.txt)
poetry.lock
Pipfile.lock
yarn.lock
package-lock.json

# Node modules (if any JavaScript tooling is added)
node_modules/

