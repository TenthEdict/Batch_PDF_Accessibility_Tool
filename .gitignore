.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*
.smbdelete*

# ===================================================================
# Project data and processing artifacts
# ===================================================================
# Input/output directories
input/
output/
data/
temp/
tmp/
logs/
cache/
downloads/
processing_output/
enhanced_pdfs/
validation_output/
test_batch_output/
test_batch_input/
orchestration_output/
pipeline_cache/
scraper_cache/

# Preserve directory structure but ignore contents
processor/unified_project/data/input/*
processor/unified_project/data/output/*
!processor/unified_project/data/input/.gitkeep
!processor/unified_project/data/output/.gitkeep

# Processing artifacts
temp_processing/
automation/downloaded_materials/
automation/logs/
scraper/temp/
processor/unified_project/src/orchestration/temp/
processor/unified_project/src/orchestration/logs/

# ===================================================================
# Document files
# ===================================================================
# PDF files (except test fixtures)
*.pdf
!processor/unified_project/tests/fixtures/*.pdf
!**/test_*.pdf
!**/sample_*.pdf

# Document processing temporary files
ocrmypdf_*
tesseract_*
*.hocr

# Image files (except resources)
*.png
*.jpg
*.jpeg
*.tiff
*.bmp
*.gif
*.webp
*.svg
!**/resources/*.png
!**/resources/*.jpg
!**/static/*.png
!**/static/*.jpg
!**/assets/*.png
!**/assets/*.jpg

# Office documents
*.docx
*.pptx
*.xlsx
*.doc
*.ppt
*.xls
!**/test_*.docx
!**/resources/*.docx

