# Enhanced configuration file for Tesseract OCR with historical document optimizations

# Character recognition parameters - optimized for historical fonts and degraded text
matcher_good_threshold 0.30  # Lower threshold to capture more potential matches
matcher_bad_match_pad 0.20   # Increased to be more lenient with broken characters
tessedit_consistent_reps 1
edges_boxarea 0.7           # Reduced to handle more degraded character edges
edges_max_children_per_outline 25  # Increased to handle more complex characters
segsearch_max_char_wh_ratio 2.5   # Higher ratio for historical fonts with unusual proportions

# Language model parameters - strengthened for historical text
language_model_penalty_non_freq_dict_word 0.05  # Reduced penalty for unusual words
language_model_ngram_scale_factor 0.1          # Increased to leverage context more
language_model_min_compound_length 3           # Better handling of compound words
permuter_pending_threshold 0                   # Be more aggressive with character permutations

# Page segmentation parameters - improved for historical layouts and degradation
textord_noise_sizelimit 0.3        # Increased to handle more document noise
textord_fp_chop_error 2.0          # More aggressive chopping for broken characters
textord_really_old_xheight 1       # Enable special handling for old typography
textord_old_graphemes 1            # Enable support for historical graphemes
textord_min_linesize 1.0           # Reduced to capture smaller text lines
textord_min_xheight 5              # Adjusted for smaller historical x-heights
textord_noise_debug_images 0
textord_max_noise_size 8           # Increased for handling historical document noise

# Dictionary settings - improved for historical text recognition
load_freq_dawg 1
load_unambig_dawg 1
load_system_dawg 1
load_punc_dawg 1                   # Enable punctuation dictionary
load_number_dawg 1                 # Enable number dictionary
user_words_suffix historical_words
user_patterns_suffix historical_patterns
tessedit_enable_dict_correction 1  # Enable dictionary-based correction
tessedit_enable_bigram_correction 1 # Enable correction based on word pairs

# Font optimization for historical typography
classify_character_fragments 0      # Disable to better handle joined characters
chop_enable 0                       # Disable chopping for historical ligatures
textord_noise_certaintity 2.0       # Increased for better noise filtering
classify_min_norm_scale_x 0.5       # Reduced to handle scale variations in old type
classify_max_norm_scale_x 1.5       # Increased for historical typography variations
classify_norm_method 1              # Use advanced normalization for historical fonts
poly_wide_objects_better 1          # Better handling of wide character shapes
tessedit_prefer_joined_punct 0      # Avoid joining punctuation in historical text
disable_character_fragments 1       # Don't attempt to recognize fragments

# Broken character handling - critical for degraded historical documents
edges_min_nonhole 8                 # Reduced for more degraded characters
classify_min_pattern_size_for_pruning 0.15  # Reduced to preserve more features
edges_children_count_limit 60       # Increased for more complex character shapes
textord_noise_hfract 0.5            # More aggressive noise filtering
textord_noise_rowratio 10.0         # Increased for historical document noise patterns
tessedit_fix_fuzzy_spaces 1         # Better handling of unclear spaces

# White space handling - optimized for historical typesetting
preserve_interword_spaces 1
textord_word_for_word 0
textord_tabfind_force_vertical_text 0
textord_tabfind_vertical_text 0
assume_fixed_pitch_char_segment 0   # Disable for variable-width historical fonts
tessedit_preserve_min_wd_len 2      # Preserve very short words (common in old text)
tessedit_write_block_separators 0   # Don't insert block separators
tessedit_space_level 5              # More aggressive space finding

# Special improvements for historical documents
tessedit_training_mode 0            # Disable training mode
tessedit_debug_fonts 0              # Disable font debugging
tessedit_debug_block_rejection 0    # Disable block rejection debugging
textord_show_fixed_cuts 0           # Disable showing fixed cuts
tessedit_minimal_rejection 1        # Use minimal rejection for historical docs
tessedit_unrej_use_hmm 1            # Use HMM for unreliable areas
tessedit_print_text 0               # Disable debug text printing
tessedit_adapt_to_char_fragments 1  # Enable adaptation to character fragments
use_only_first_uft8_step 0          # Enable full UTF-8 processing
tessedit_tess_adaption_mode 155     # Special adaptation mode for historical docs