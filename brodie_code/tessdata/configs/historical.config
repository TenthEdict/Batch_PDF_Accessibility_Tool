# Configuration file for Tesseract OCR with historical document optimizations

# Character recognition parameters
matcher_good_threshold 0.35
matcher_bad_match_pad 0.15
tessedit_consistent_reps 1
edges_boxarea 0.8
edges_max_children_per_outline 20

# Language model parameters
language_model_penalty_non_freq_dict_word 0.1
language_model_ngram_scale_factor 0.05

# Page segmentation parameters
textord_noise_sizelimit 0.2
textord_fp_chop_error 1.5
textord_really_old_xheight 1
textord_old_graphemes 1

# Dictionary settings 
load_freq_dawg 1
load_unambig_dawg 1
load_system_dawg 1
user_words_suffix historical_words
user_patterns_suffix historical_patterns

# Font optimization
classify_character_fragments 0
chop_enable 0
textord_noise_certaintity 1.5

# Broken character handling
edges_min_nonhole 12
classify_min_pattern_size_for_pruning 0.2
edges_children_count_limit 45

# White space handling
preserve_interword_spaces 1
textord_word_for_word 0
textord_tabfind_force_vertical_text 0
textord_tabfind_vertical_text 0